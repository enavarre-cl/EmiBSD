{
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(cargo:*)"
    ],
    "deny": [
      "Edit(/reference/**)",
      "Edit(reference/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-check.sh",
            "timeout": 180,
            "statusMessage": "lz check + fmt before git commit"
          }
        ]
      }
    ]
  }
}
